  "adapters": {
    "always_enabled_versioning": "The pinned Ceph tests call PutBucketVersioning(Enabled) before versioned cases, while the pgs3 Phase 1 contract has versioning enabled permanently and does not expose PutBucketVersioning. The pytest adapter turns only Status=Enabled (with optional MFADelete=Disabled) into a local success response. Suspended and every other request still reach the endpoint and fail normally.",
    "pure_python_negative_expiry_signer": "The pinned awscrt rejects ExpiresIn=-1000 with a client-side assertion before the selected expiry test can contact pgs3. The suite sets BOTO_DISABLE_CRT=true so botocore's pinned pure-Python SigV4 signer preserves X-Amz-Expires=-1000 and the endpoint must reject it; explicit precomputed CRC64NVME coverage remains selected."
  },
  "excluded_classes": {
    "acl_and_public_access": "Phase 1 authorizes mapped PostgreSQL roles through RLS and does not implement S3 ACL grants or anonymous-public ACL behavior.",
    "bucket_policy_and_iam": "Bucket policy, IAM, ownership controls and public-access-block APIs are not Phase 1 APIs; RLS isolation is exercised separately and by cross-tenant copy cases.",
    "lifecycle_and_restore": "Lifecycle configuration, transition, expiration and restore are outside the synchronous Phase 1 API; database GC has a separate acceptance suite.",
    "website_cors_post": "Static website hosting, CORS configuration and browser POST policy uploads are not Phase 1 routes.",
    "sse_and_object_lock": "SSE-C, SSE-S3, KMS and Object Lock are explicitly outside Phase 1.",
    "sts_sns_s3control_select_logging": "STS, SNS notifications, S3 Control, S3 Select and Ceph bucket logging are separate services/extensions, not Phase 1 S3 data-plane APIs.",
    "tagging_torrent_attributes": "Tagging, torrents, GetObjectAttributes, GetObject PartNumber and UploadPartCopy are not included in the Phase 1 route set.",
    "versioning_suspension": "pgs3 versioning is always enabled; non-versioned, suspended and null-version transition cases conflict with the specified storage model.",
    "sigv2": "The endpoint intentionally implements AWS Signature Version 4 only; SigV2-only tests are excluded while SigV4 header/query coverage remains mandatory.",
    "ceph_allow_unordered": "The Ceph-only allow-unordered query extension conflicts with Phase-1 ordered V1/V2 list behavior.",
    "non_aws_put_condition_variants": "Phase 1 requires atomic If-None-Match:* and If-Match:<etag>; wildcard If-Match and arbitrary-tag If-None-Match variants marked fails_on_aws are outside that contract.",
    "tenant_non_disclosure_conflict": "Cross-tenant source existence is intentionally hidden as missing, including CopyObject; tests requiring a revealing 403 conflict with this security invariant.",
    "us_east_1_location_null": "AWS GetBucketLocation represents us-east-1 with an empty LocationConstraint; the pinned fixture supplies the literal region name and therefore expects a non-wire-compatible string.",
    "consumed_upload_completion_retry": "Phase 1 consumes an upload ID after successful CompleteMultipartUpload; AWS documents NoSuchUpload for IDs that were already completed, so repeated-success completion is an extension rather than a core requirement.",
    "duplicate_complete_part_numbers": "Phase 1 requires the CompleteMultipartUpload part list to be strictly increasing; the pinned race case submits two entries with the same PartNumber and conflicts with that validation contract."
  }
}
